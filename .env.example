# Jàngal — environment configuration (all optional; docker compose sets sane defaults)

# --- Lightning nodes (docker-compose service names) ---
LND_SCHOOL_REST=https://lnd-school:8080
LND_PARENT_REST=https://lnd-parent:8080
LND_WALLET_PASSWORD=jangaldemo
CHANNEL_AMOUNT_SAT=10000000

# --- bitcoind (regtest) ---
BITCOIND_HOST=bitcoind
BITCOIND_RPCPORT=18443
BITCOIND_RPCUSER=jangal
BITCOIND_RPCPASS=jangal

# --- app ---
PORT=3000
NODE_ENV=production
DATA_DIR=./data
JWT_SECRET=change-me-in-production
SEED_ON_BOOT=1
ALLOW_MINING=1          # regtest demo only

# --- demo FX rate (1 sat in FCFA; derivation in docs/impact.md) ---
RATE_XOF_PER_SAT=0.85
FEE_EXPIRY_SECONDS=3600

# --- AI (mock = deterministic, offline; openai-compatible = any /v1/chat/completions) ---
AI_PROVIDER=mock
AI_BASE_URL=            # e.g. https://api.open.bigmodel.cn/v1
AI_MODEL=               # e.g. glm-4-flash
AI_API_KEY=
AI_TIMEOUT_MS=20000

# --- development ---
# LND_MODE=mock          # simulate LND for UI work without containers
# LOG_LEVEL=debug
